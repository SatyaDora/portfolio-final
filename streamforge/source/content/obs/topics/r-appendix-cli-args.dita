<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="appendix-cli-args" otherprops="fa-capture">
  <title>Appendix: Command-Line Arguments</title>
  <shortdesc>Flags accepted when launching OBS Studio from a terminal or shortcut.</shortdesc>
  <refbody>
    <simpletable relcolwidth="1* 2*">
      <sthead>
        <stentry>Argument</stentry>
        <stentry>Effect</stentry>
      </sthead>
      <strow>
        <stentry><parmname>--startstreaming</parmname></stentry>
        <stentry>Begins streaming immediately on launch.</stentry>
      </strow>
      <strow>
        <stentry><parmname>--startrecording</parmname></stentry>
        <stentry>Begins recording immediately on launch.</stentry>
      </strow>
      <strow>
        <stentry><parmname>--collection "Name"</parmname></stentry>
        <stentry>Launches with a specific scene collection active.</stentry>
      </strow>
      <strow>
        <stentry><parmname>--profile "Name"</parmname></stentry>
        <stentry>Launches with a specific profile active.</stentry>
      </strow>
      <strow>
        <stentry><parmname>--minimize-to-tray</parmname></stentry>
        <stentry>Starts minimized to the system tray.</stentry>
      </strow>
    </simpletable>
  </refbody>
</reference>
